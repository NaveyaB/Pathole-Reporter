# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# JSON Web Token
JWT_SECRET=smart-pothole-reporter-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# MongoDB (optional - the API falls back to a seeded in-memory store when not set)
MONGO_URI = mongodb+srv://admin:<db_password>@cluster0.2rsypsq.mongodb.net/?appName=Cluster0
DB_ENGINE = memory

# Client
CLIENT_URL=http://localhost:5173

# ML service (FastAPI + YOLOv8 road-damage detection)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=60000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10mb

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=300

# Cloudinary (optional - future image CDN integration)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
